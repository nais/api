extend interface Workload {
	"Workload events, newest first."
	events(
		"Get the first n items, optionally after a cursor."
		first: Int
		"Get items after this cursor."
		after: Cursor
		"Get the last n items before a cursor."
		last: Int
		"Get items before this cursor."
		before: Cursor
		"Filter events by time."
		filter: WorkloadEventFilter
	): WorkloadEventConnection!
}

extend type Application {
	"Application events, newest first."
	events(
		"Get the first n items, optionally after a cursor."
		first: Int
		"Get items after this cursor."
		after: Cursor
		"Get the last n items before a cursor."
		last: Int
		"Get items before this cursor."
		before: Cursor
		"Filter events by time."
		filter: WorkloadEventFilter
	): WorkloadEventConnection!
}

extend type Job {
	"Job events, newest first."
	events(
		"Get the first n items, optionally after a cursor."
		first: Int
		"Get items after this cursor."
		after: Cursor
		"Get the last n items before a cursor."
		last: Int
		"Get items before this cursor."
		before: Cursor
		"Filter events by time."
		filter: WorkloadEventFilter
	): WorkloadEventConnection!
}

"Event time bounds."
input WorkloadEventFilter {
	"Only include events triggered at or after this timestamp."
	from: Time
	"Only include events triggered before this timestamp."
	to: Time
}

"A workload event."
interface WorkloadEvent implements Node {
	"Unique event identifier."
	id: ID!
	"When the event occurred."
	triggeredAt: Time!
	"Event summary."
	message: String!
}

"A successful replica count change."
type WorkloadSuccessfulRescaleEvent implements WorkloadEvent & Node {
	"Unique event identifier."
	id: ID!
	"When the event occurred."
	triggeredAt: Time!
	"Event summary."
	message: String!
	"Replica count after an autoscaling event."
	newSize: Int!
	"Autoscaling direction."
	direction: WorkloadSuccessfulRescaleEventDirection!
}

"Autoscaling direction."
enum WorkloadSuccessfulRescaleEventDirection {
	"Replica count increased."
	UP
	"Replica count decreased."
	DOWN
}

"A container restart."
type WorkloadKillingEvent implements WorkloadEvent & Node {
	"Unique event identifier."
	id: ID!
	"When the event occurred."
	triggeredAt: Time!
	"Event summary."
	message: String!
	"Restarted container."
	container: String!
	"Restart reason."
	reason: String!
}

"""
A problem detected while running the workload.
Repeated occurrences of the same problem are combined into a single event.
"""
type WorkloadWarningEvent implements WorkloadEvent & Node {
	"Unique event identifier."
	id: ID!
	"When the problem was last observed."
	triggeredAt: Time!
	"Description of the problem."
	message: String!
	"The kind of problem."
	kind: WorkloadWarningEventKind!
	"Name of the affected instance, if the problem concerns a single instance."
	instance: String
	"Number of times the problem has been observed."
	count: Int!
	"When the problem was first observed."
	firstSeenAt: Time!
}

"The kind of problem reported by a warning event."
enum WorkloadWarningEventKind {
	"No server with enough available resources was found to run the instance."
	PLACEMENT_FAILED
	"Files or storage could not be mounted into the instance."
	MOUNT_FAILED
	"The container image could not be downloaded."
	IMAGE_PULL_FAILED
	"The instance could not be started, for example because of missing configuration."
	START_FAILED
	"The instance keeps crashing and is restarted with increasing delay."
	CRASH_LOOP
	"A readiness, liveness or startup check failed."
	HEALTH_CHECK_FAILED
	"The instance was stopped by the platform, for example to free up resources."
	INSTANCE_STOPPED
	"New instances could not be created, for example because of a quota or a platform policy."
	INSTANCE_CREATION_FAILED
	"Automatic scaling is unable to adjust the number of instances."
	SCALING_FAILED
	"A job run failed permanently."
	RUN_FAILED
}

"A paginated collection of events."
type WorkloadEventConnection {
	"Pagination information."
	pageInfo: PageInfo!
	"Events in this page."
	nodes: [WorkloadEvent!]!
	"Events with their pagination cursors."
	edges: [WorkloadEventEdge!]!
}

"An event with its pagination cursor."
type WorkloadEventEdge {
	"Pagination cursor for the event."
	cursor: Cursor!
	"The event."
	node: WorkloadEvent!
}
